// DOCTECH - Multi-Tenant Clinic Management System
// Prisma Schema with Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ==============================
// MULTI-TENANT: Clinic (Tenant)
// ==============================
model Clinic {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  address     String?
  logoUrl     String?
  clerkOrgId  String   @unique // Clerk Organization ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors          Doctor[]
  secretaries      Secretary[]
  patients         Patient[]
  appointments     Appointment[]
  reports          Report[]
  notifications    Notification[]
  conversations    WhatsAppConversation[]
  schedules        DoctorSchedule[]
  appointmentTypes AppointmentType[]

  @@map("clinics")
}

// ==============================
// USERS
// ==============================
model Doctor {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String
  specialty   String?
  avatarUrl   String?
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments  Appointment[]
  reports       Report[]
  notifications Notification[]
  messages      InternalMessage[]
  schedules     DoctorSchedule[]

  @@map("doctors")
}

model Secretary {
  id           String          @id @default(cuid())
  clerkUserId  String          @unique
  email        String          @unique
  name         String
  avatarUrl    String?
  status       SecretaryStatus @default(ACTIVE)
  clinicId     String
  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedAt    DateTime?
  activatedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  appointments  Appointment[]
  notifications Notification[]
  messages      InternalMessage[]

  @@map("secretaries")
}

// ==============================
// DOCTOR SCHEDULE (Working Hours + Slot Config)
// ==============================
model DoctorSchedule {
  id           String  @id @default(cuid())
  doctorId     String
  doctor       Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId     String
  clinic       Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dayOfWeek    Int     // 0=Sunday ... 6=Saturday
  startTime    String  // "09:00" (24h format)
  endTime      String  // "17:00" (24h format)
  slotDuration Int     @default(30) // minutes per slot
  isActive     Boolean @default(true)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

// ==============================
// APPOINTMENT TYPES (Custom per Clinic)
// ==============================
model AppointmentType {
  id       String  @id @default(cuid())
  clinicId String
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  nameEn   String
  nameAr   String
  fee      Float?  // Default fee for this type
  isActive Boolean @default(true)

  appointments Appointment[]

  @@map("appointment_types")
}

// ==============================
// PATIENTS
// ==============================
model Patient {
  id          String    @id @default(cuid())
  name        String
  phone       String
  email       String?
  dateOfBirth DateTime?
  gender      Gender    @default(UNKNOWN)
  address     String?
  notes       String?
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments  Appointment[]
  reports       Report[]
  conversations WhatsAppConversation[]
  attachments   PatientAttachment[]

  @@map("patients")
}

// ==============================
// PATIENT ATTACHMENTS (X-rays, Prescriptions, Files)
// ==============================
model PatientAttachment {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?      // null = general attachment (not tied to a visit)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  clinicId      String
  fileName      String
  fileUrl       String
  fileType      String       // "image", "pdf", "xray", "prescription"
  description   String?
  uploadedAt    DateTime     @default(now())

  @@map("patient_attachments")
}

// ==============================
// APPOINTMENTS
// ==============================
model Appointment {
  id                String            @id @default(cuid())
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id])
  doctorId          String
  doctor            Doctor            @relation(fields: [doctorId], references: [id])
  secretaryId       String?
  secretary         Secretary?        @relation(fields: [secretaryId], references: [id])
  clinicId          String
  clinic            Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentTypeId String?
  appointmentType   AppointmentType?  @relation(fields: [appointmentTypeId], references: [id])
  date              DateTime
  duration          Int               @default(30) // in minutes
  status            AppointmentStatus @default(SCHEDULED)
  source            AppointmentSource @default(MANUAL)
  bookingStatus     BookingStatus     @default(APPROVED)
  type              String?           // Legacy free-text type (kept for backward compat)
  notes             String?
  // Payment fields
  fee               Float?
  amountPaid        Float?            @default(0)
  paymentMethod     PaymentMethod?
  paymentDate       DateTime?
  paymentNotes      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  attachments PatientAttachment[]

  @@map("appointments")
}

// ==============================
// REPORTS (Patient Messages / Inquiries)
// ==============================
model Report {
  id           String       @id @default(cuid())
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  clinicId     String
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  content      String       // Patient's message/report
  triageNotes  String?      // Secretary's triage notes
  doctorReview String?      // Doctor's medical review
  replyMethod  ReplyMethod?
  aiReply      String?      // AI-generated reply (if replyMethod = AI)
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("reports")
}

// ==============================
// WHATSAPP
// ==============================
model WhatsAppConversation {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id])
  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  waId       String    // WhatsApp phone number ID
  status     WaStatus  @default(OPEN)
  lastMessage String?
  lastMessageAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from           MessageFrom
  content        String
  waMessageId    String?              // Meta's message ID
  status         WaMessageStatus      @default(SENT)
  sentAt         DateTime             @default(now())

  @@map("whatsapp_messages")
}

// ==============================
// INTERNAL COMMUNICATION
// ==============================
model InternalMessage {
  id          String    @id @default(cuid())
  clinicId    String?   // For multi-tenant isolation
  channelId   String?   // Channel or conversation ID ("doctor_secretary_direct", "broadcast", etc.)
  doctorId    String?
  doctor      Doctor?   @relation(fields: [doctorId], references: [id])
  secretaryId String?
  secretary   Secretary? @relation(fields: [secretaryId], references: [id])
  senderRole  String?   // "doctor" | "secretary"
  senderName  String?   // Display sender name
  content     String
  isRead      Boolean   @default(false)
  sentAt      DateTime  @default(now())

  @@map("internal_messages")
}

// ==============================
// NOTIFICATIONS
// ==============================
model Notification {
  id          String           @id @default(cuid())
  clinicId    String
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId    String?
  doctor      Doctor?          @relation(fields: [doctorId], references: [id])
  secretaryId String?
  secretary   Secretary?       @relation(fields: [secretaryId], references: [id])
  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false)
  link        String?
  createdAt   DateTime         @default(now())

  @@map("notifications")
}

// ==============================
// ENUMS
// ==============================
enum SecretaryStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  MANUAL
  AI
  WHATSAPP
}

enum BookingStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
}

enum ReportStatus {
  PENDING
  TRIAGED
  REVIEWED
  REPLIED
  CLOSED
}

enum ReplyMethod {
  HUMAN
  AI
}

enum WaStatus {
  OPEN
  CLOSED
}

enum WaMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageFrom {
  PATIENT
  CLINIC
  AI
}

enum NotificationType {
  NEW_APPOINTMENT
  APPOINTMENT_CANCELLED
  APPOINTMENT_MODIFIED
  NEW_REPORT
  REPORT_REVIEWED
  WHATSAPP_MESSAGE
  AI_BOOKING_REQUEST
  APPOINTMENT_REMINDER
  SECRETARY_INVITATION
  INTERNAL_MESSAGE
  SYSTEM
}
