# Supabase
# Get these from https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy alias for the anon key (optional fallback)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL (Prisma)
# Run `npx prisma generate` after setting this
DATABASE_URL=

# WhatsApp Business Cloud API (Meta)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token used for the GET verification handshake with Meta.
# Generate a fresh random value; do not reuse the value above.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta App Secret. Required: the webhook rejects every POST that does not carry a
# valid X-Hub-Signature-256 for this secret (fail-closed).
# Meta Dashboard -> App Settings -> Basic -> App secret
WHATSAPP_APP_SECRET=

# OpenRouter AI Models (Hermes Agent)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_FALLBACK_MODEL=thudm/glm-4-9b-chat

# ============ Admin / Provisioning ============
# Guards POST /api/admin/setup-doctech via the x-admin-setup-secret header.
# The route stays disabled (503) while this is unset.
ADMIN_SETUP_SECRET=

# Seed account created by the setup route. The password is required server-side and
# is never returned in the HTTP response.
DOCTECH_SEED_DOCTOR_EMAIL=
DOCTECH_SEED_DOCTOR_PASSWORD=